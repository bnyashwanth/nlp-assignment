# ============================================================================
# LinguaBridge AI - Backend Environment Configuration Template (.env.example)
# ============================================================================
# Copy this file to .env and adjust variables to suit your deployment environment.

# ----------------------------------------------------------------------------
# 1. Server Configuration
# ----------------------------------------------------------------------------
# Server port (7860 is mandatory for Hugging Face Spaces; 8000 for standard local dev)
PORT=7860

# Enable debug mode and automatic reload (true/false)
DEBUG=false

# Allowed CORS origins (comma-separated or wildcard '*')
CORS_ORIGINS=*

# ----------------------------------------------------------------------------
# 2. Foundation Model & Hugging Face Hub Settings
# ----------------------------------------------------------------------------
# IndicTrans2 1B model families from Hugging Face Hub
INDICTRANS2_EN_INDIC=ai4bharat/indictrans2-en-indic-1B
INDICTRANS2_INDIC_EN=ai4bharat/indictrans2-indic-en-1B
INDICTRANS2_INDIC_INDIC=ai4bharat/indictrans2-indic-indic-1B

# Hugging Face User Access Token (Required if repo is private or to prevent rate limits)
HF_TOKEN=your_huggingface_token_here

# Path to evaluated benchmark metrics JSON file
METRICS_FILE_PATH=../ml/outputs/metrics.json

# ----------------------------------------------------------------------------
# 3. Hardware & Execution Bounds
# ----------------------------------------------------------------------------
# Target computation device ('cuda', 'cpu', or leave unset for auto-detection)
DEVICE=cpu

# Use FP16 half-precision on CUDA devices (true/false)
USE_FP16=true

# Maximum allowable input character count per translation request
MAX_INPUT_CHARS=2000

# Minimum allowable input character count
MIN_INPUT_CHARS=1

# Maximum sequence length for autoregressive decoder generation
MAX_GENERATION_LENGTH=256

# Default beam search width for beam decoding
DEFAULT_BEAM_SIZE=4

# Inference timeout threshold in seconds before returning HTTP 504
TRANSLATION_TIMEOUT_SECONDS=30.0
